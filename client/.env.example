# Phase 1 ships entirely on mock services — no environment variables are
# required to run the app. This file documents what Phase 2 will need once
# the Express/MongoDB backend is connected.
#
# Only NON-secret, browser-exposed configuration belongs here. Vite inlines
# every VITE_-prefixed variable into the client bundle, so never put backend
# secrets, database URLs, or API keys behind this prefix.

# Base URL of the backend API (Phase 2)
VITE_API_BASE_URL=http://localhost:4000/api

# Must match the backend's ADMIN_ROUTE_PREFIX (server/.env) — the admin API
# is mounted at /api/v1/<that value> instead of the predictable
# /api/v1/admin, as defense-in-depth against automated scanners. Defaults to
# "admin" if unset. This is baked into the built JS bundle like every other
# VITE_-prefixed var, so it is NOT a secret — it only helps against
# unauthenticated mass-scanning bots, not a targeted attacker who already
# has the frontend bundle. Real access control is still requireRole('ADMIN')
# on the backend.
VITE_ADMIN_ROUTE_PREFIX=admin
