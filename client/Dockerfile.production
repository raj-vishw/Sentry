# Production image — builds the static Vite bundle and serves it via nginx,
# which also reverse-proxies /api to the backend container. Unlike
# ./Dockerfile (dev-only, runs the Vite dev server), nothing here needs a
# bind-mount or Node at runtime.

FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
