# Copy to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/breach

# JWT secrets — use long, random values in every real environment.
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origin(s) allowed to make credentialed requests to this API (comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# The admin API is mounted at /api/v1/<this value> instead of the fixed
# /api/v1/admin — defense-in-depth against automated scanners that probe
# common admin paths, NOT a replacement for auth (every admin route is still
# independently gated by requireRole('ADMIN')). Keep it lowercase
# letters/numbers/hyphens only. Defaults to "admin" if unset, which is fine
# for local dev, but every real deployment should set this to something
# non-guessable, e.g. `node -e "console.log(require('crypto').randomBytes(8).toString('hex'))"`.
# The frontend must be told the same value via client/.env's
# VITE_ADMIN_ROUTE_PREFIX, or its admin console will call the wrong path.
ADMIN_ROUTE_PREFIX=admin

# Where the repo's docs/ folder lives, for the /docs browser (see
# docs/configuration.md). Leave unset for bare-metal dev — it defaults to
# "one level up from the server/ directory," which is correct there. Only
# needs to be set explicitly inside Docker (both compose files already do
# this for you — see docker-compose.yml / docker-compose.production.yml).
DOCS_DIR=

# Only read by `npm run seed` (server/src/scripts/seed.ts) — required to
# seed a dev admin + two sample users. Pick your own values; never commit
# real ones. The script refuses to run if any of these are unset.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@dev.local
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_USER1_USERNAME=operator_01
SEED_USER1_EMAIL=operator01@dev.local
SEED_USER2_USERNAME=nullbyte
SEED_USER2_EMAIL=nullbyte@dev.local
SEED_USER_PASSWORD=change-me-user-password
